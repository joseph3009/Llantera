@model ICollection<UsuariosDTO>

@{
	ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1 class="h3 mb-0">Usuarios</h1>
	<a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</div>

<div class="table-responsive">
	<table class="table table-striped table-hover align-middle">
		<thead>
			<tr>
				<th>Id</th>
				<th>Nombre</th>
				<th>Correo</th>
				<th>Teléfono</th>
				<th>Rol</th>
				<th>Estado</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.Any())
			{
				foreach (var item in Model)
				{
					<tr>
						<td>@item.Id</td>
						<td>@item.Nombre</td>
						<td>@item.Correo</td>
						<td>@item.Telefono</td>
						<td>@item.IdrolNavigation?.Descripcion</td>
						<td>
							@if (item.Estado)
							{
								<span class="badge bg-success">Activo</span>
							}
							else
							{
								<span class="badge bg-secondary">Inactivo</span>
							}
						</td>
						<td class="text-end">
							<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Ver</a>
							<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
						</td>
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="7" class="text-center text-muted py-4">No hay usuarios registrados.</td>
				</tr>
			}
		</tbody>
	</table>
</div>