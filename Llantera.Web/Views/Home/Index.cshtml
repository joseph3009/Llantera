    <div class="cta-content">
        <span class="cta-tag">CONTACTO</span>
        <h2 class="reveal">¿LISTO<br />PARA SEGUIR?</h2>
        <p class="reveal">Cotiza tu próximo juego de llantas y agenda tu cita sin filas de espera.</p>
        <a href="tel:+50600000000" class="btn-primary large reveal">Cotizar ahora <span class="arrow">→</span></a>
        <div class="cta-line"></div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // ========================= BRANDS HORIZONTAL SCROLL =========================
        const section = document.querySelector(".brands-horizontal");
        const sticky = document.querySelector(".brands-sticky");
        const track = document.querySelector("#brandsTrack");
        const current = document.querySelector("#brandCurrent");
        const scrollLine = document.querySelector(".brands-scroll-line i");

        if (!section || !sticky || !track) return;

        let maxTranslate = 0;

        function calculateHorizontalScroll() {
            if (window.innerWidth <= 860) {
                maxTranslate = 0;
                return;
            }
            const viewportWidth = window.innerWidth;
            maxTranslate = Math.max(0, track.scrollWidth - viewportWidth);
        }

        function updateHorizontalScroll() {
            if (window.innerWidth <= 860) {
                track.style.transform = "none";
                return;
            }

            const sectionTop = section.offsetTop;
            const scrollDistance = section.offsetHeight - sticky.offsetHeight;

            if (scrollDistance <= 0) return;

            let progress = (window.scrollY - sectionTop) / scrollDistance;
            progress = Math.max(0, Math.min(1, progress));

            const translateX = maxTranslate * progress;
            track.style.transform = `translate3d(${-translateX}px, 0, 0)`;

            section.style.setProperty("--brands-progress", `${progress * 100}%`);

            let brandIndex = Math.floor(progress * 3) + 1;
            brandIndex = Math.max(1, Math.min(3, brandIndex));
            current.textContent = String(brandIndex).padStart(2, "0");

            if (scrollLine) {
                scrollLine.style.transform = `translateX(${progress * 230}%)`;
            }
        }

        function refresh() {
            calculateHorizontalScroll();
            updateHorizontalScroll();
        }

        window.addEventListener("scroll", updateHorizontalScroll, { passive: true });
        window.addEventListener("resize", refresh);
        refresh();

        // ========================= SERVICES INTERACTION =========================
        const items = document.querySelectorAll(".service-item");
        const image = document.getElementById("servicesImage");
        const nameDisplay = document.getElementById("serviceCurrentName");

        if (items.length && image) {
            function setActive(activeItem) {
                items.forEach(item => item.classList.remove("is-active"));
                activeItem.classList.add("is-active");

                const src = activeItem.dataset.image;
                const alt = activeItem.dataset.alt || "";
                const name = activeItem.querySelector(".service-name")?.textContent || "";

                if (src) {
                    image.classList.remove("is-visible");
                    setTimeout(() => {
                        image.src = src;
                        image.alt = alt;
                        image.classList.add("is-visible");
                    }, 200);
                }

                if (nameDisplay) {
                    nameDisplay.textContent = name.toUpperCase();
                }
            }

            items.forEach(item => {
                item.addEventListener("click", () => setActive(item));
                item.addEventListener("keydown", (e) => {
                    if (e.key === "Enter") setActive(item);
                });
            });

            const firstActive = document.querySelector(".service-item.is-active");
            if (firstActive) setActive(firstActive);
        }

        // ========================= REVEAL ANIMATIONS =========================
        const reveals = document.querySelectorAll(".reveal");

        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                }
            });
        }, {
            threshold: 0.15,
            rootMargin: "0px 0px -50px 0px"
        });

        reveals.forEach(el => revealObserver.observe(el));

        // ========================= HERO TITLE ANIMATION =========================
        const heroTitle = document.getElementById("heroTitle");
        if (heroTitle) {
            setTimeout(() => {
                heroTitle.classList.add("is-in");
            }, 300);
        }

        // ========================= CTA LINE ANIMATION =========================
        const ctaFinal = document.querySelector(".cta-final");
        if (ctaFinal) {
            const ctaObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        ctaFinal.classList.add("is-visible");
                    }
                });
            }, { threshold: 0.3 });
            ctaObserver.observe(ctaFinal);
        }
    });
</script>