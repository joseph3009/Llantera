                <h1 class="hero-title" id="heroTitle">
                    <span class="line"><span class="line-inner">EL CAMINO</span></span>
                    <span class="line"><span class="line-inner">EMPIEZA</span></span>
                    <span class="line"><span class="line-inner accent">AQUÍ.</span></span>
                </h1>
                <p class="hero-sub reveal">Servicio de llantas para quienes no se detienen</p>
                <a href="#servicios" class="btn-primary reveal">Ver servicios <span class="arrow">→</span></a>
            </div>

            <div class="hero-wheel-area">
                <div class="hero-track-ring"></div>
                <div class="hero-speed-lines">
                    <span class="speed-line s2"></span>
                    <span class="speed-line s3"></span>
                    <span class="speed-line s4"></span>
                    <span class="speed-line s5"></span>
                    <span class="speed-line s6"></span>
                    <span class="speed-line s7"></span>
                </div>
                <div class="hero-tread-pattern"></div>
                <div class="hero-core-glow"></div>
                <div class="hero-wheel-fade"></div>
                <img class="hero-wheel" src="images/llanta.png" alt="Llanta" />
