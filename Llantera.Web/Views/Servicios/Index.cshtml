@model ICollection<ServiciosDTO>

@{
    ViewData["Title"] = "Servicios — Llantera Wifragara";
}

<!-- ================================ HERO SERVICIOS ============================= -->
<section class="hero-services" id="hero-servicios">
    <div class="hero-services-media">
        <img class="hero-services-image"
             src="https://images.pexels.com/photos/3807695/pexels-photo-3807695.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1920"
             alt="Taller de llantas con herramientas profesionales" />
        <div class="hero-services-overlay"></div>
    </div>

    <div class="hero-services-content">
        <div class="hero-services-grid">
            <div class="hero-services-text">
                <p class="hero-services-eyebrow">LLANTERA WIFRAGARA</p>
                <h1 class="hero-services-title" id="heroServicesTitle">
                    <span class="line"><span class="line-inner">NUESTROS</span></span>
                    <span class="line"><span class="line-inner">SERVICIOS</span></span>
                    <span class="line"><span class="line-inner accent">PROFESIONALES</span></span>
                </h1>
                <p class="hero-services-sub">Soluciones técnicas para mantener tu vehículo en óptimas condiciones</p>
            </div>
        </div>
    </div>

    <div class="scroll-cue"><span></span>DESPLÁZATE</div>
</section>

<!-- ================================ SERVICIOS CARDS ============================= -->
<section class="services-cards" id="servicios-lista">
    <div class="services-cards-head">
        <div class="services-cards-heading">
            <span class="services-cards-eyebrow">CATÁLOGO COMPLETO</span>
            <h2>
                PRECISIÓN<br>
                <span>EN CADA SERVICIO</span>
            </h2>
        </div>
        <div class="services-cards-intro">
            <span class="services-cards-line"></span>
            <p>
                Conoce todos los servicios que ofrecemos en Wifragara.
                Cada uno está diseñado para garantizar el máximo
                rendimiento y seguridad de tu vehículo.
            </p>
        </div>
    </div>

    <div class="services-cards-grid">
        @if (Model != null && Model.Any())
        {
            var index = 0;
            @foreach (var item in Model.OrderBy(x => x.Orden))
            {
                index++;
                var imageSrc = item.Imagen != null && item.Imagen.Length > 0
                    ? $"data:image/jpeg;base64,{Convert.ToBase64String(item.Imagen)}"
                    : "https://images.pexels.com/photos/3807695/pexels-photo-3807695.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800";

                <article class="service-card data-index=" @index">
                    <div class="service-card-number">@index.ToString("D2")</div>
                    <div class="service-card-visual">
                        <img src="@imageSrc"
                             alt="@item.Titulo"
                             loading="lazy" />
                        <div class="service-card-visual-overlay"></div>
                    </div>
                    <div class="service-card-content">
                        <div class="service-card-top">
                            <span class="service-card-category">
                                @if (item.IdcategoriaNavigation != null)
                                {
                                    @item.IdcategoriaNavigation.Nombre
                                }
                                else
                                {
                                    <span>SERVICIO</span>
                                }
                            </span>
                            <span class="service-card-status @(item.Activo ? "active" : "inactive")">
                                @(item.Activo ? "● Activo" : "○ Inactivo")
                            </span>
                        </div>
                        <h3 class="service-card-title">@item.Titulo</h3>
                        <p class="service-card-desc">@item.DescripcionCorta</p>
                        <div class="service-card-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="service-card-btn">
                                Ver detalles <span class="arrow">→</span>
                            </a>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <div class="service-card-admin">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="admin-btn danger" title="Eliminar" onclick="return confirm('¿Estás seguro de que deseas eliminar este servicio?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="service-card-glow"></div>
                </article>
            }
        }
        else
        {
            <div class="services-empty">
                <span class="services-empty-icon">🔧</span>
                <h3>Sin servicios registrados</h3>
                <p>No hay servicios disponibles en este momento.</p>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-action="Create" class="btn-primary">Crear primer servicio <span class="arrow">→</span></a>
                }
            </div>
        }
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // ========================= HERO TITLE ANIMATION =========================
        const heroTitle = document.getElementById("heroServicesTitle");
        if (heroTitle) {
            setTimeout(() => {
                heroTitle.classList.add("is-in");
            }, 300);
        }

        // ========================= SERVICE CARDS ANIMATION =========================
        const cards = document.querySelectorAll(".service-card");
        const cardObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add("is-visible");
                    }, index * 150);
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px"
        });

        cards.forEach(card => cardObserver.observe(card));
    });
</script>