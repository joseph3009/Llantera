@model ICollection<Llantera.Application.DTOs.ArticulosDTO>

@{
    ViewData["Title"] = "Artículos — Llantera Wifragara";
}

<!-- ================================ HERO ARTÍCULOS ============================= -->
<section class="hero-articulos" id="hero-articulos">
    <div class="hero-articulos-media">
        <img class="hero-articulos-image"
             src="https://images.pexels.com/photos/3807695/pexels-photo-3807695.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1920"
             alt="Artículos y publicaciones automotrices" />
        <div class="hero-articulos-overlay"></div>
    </div>

    <div class="hero-articulos-content">
        <div class="hero-articulos-grid">
            <div class="hero-articulos-text">
                <p class="hero-articulos-eyebrow">LLANTERA WIFRAGARA</p>
                <h1 class="hero-articulos-title" id="heroArticulosTitle">
                    <span class="line"><span class="line-inner">ARTÍCULOS</span></span>
                    <span class="line"><span class="line-inner">&</span></span>
                    <span class="line"><span class="line-inner accent">PUBLICACIONES</span></span>
                </h1>
                <p class="hero-articulos-sub">Información técnica, consejos y novedades del mundo automotriz</p>
            </div>
        </div>
    </div>

    <div class="scroll-cue"><span></span>DESPLÁZATE</div>
</section>

<!-- ================================ ARTÍCULOS CARDS ============================= -->
<section class="articulos-cards" id="articulos-lista">
    <div class="articulos-cards-head">
        <div class="articulos-cards-heading">
            <span class="articulos-cards-eyebrow">BIBLIOTECA DE CONTENIDO</span>
            <h2>
                CONOCIMIENTO<br>
                <span>Y TECNOLOGÍA</span>
            </h2>
        </div>
        <div class="articulos-cards-intro">
            <span class="articulos-cards-line"></span>
            <p>
                Explora nuestra colección de artículos especializados.
                Encuentra información útil sobre mantenimiento,
                seguridad y tendencias automotrices.
            </p>
        </div>
    </div>

    <div class="articulos-cards-grid">
        @if (Model != null && Model.Any())
        {
            var index = 0;
            @foreach (var item in Model.OrderByDescending(x => x.FechaPublicacion).ThenBy(x => x.Titulo))
            {
                index++;
                var imageSrc = item.Imagen != null && item.Imagen.Length > 0
                    ? $"data:image/jpeg;base64,{Convert.ToBase64String(item.Imagen)}"
                    : "https://images.pexels.com/photos/3807695/pexels-photo-3807695.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800";

                var fechaPublicacion = item.FechaPublicacion.HasValue
                    ? item.FechaPublicacion.Value.ToString("dd MMM yyyy")
                    : "Sin publicar";

                <!-- ELIMINÉ LA CLASE "is-active" DE LA PRIMERA TARJETA -->
                <article class="articulo-card"
                         data-index="@index">
                    <div class="articulo-card-number">@index.ToString("D2")</div>
                    <div class="articulo-card-visual">
                        <img src="@imageSrc"
                             alt="@item.Titulo"
                             loading="lazy" />
                        <div class="articulo-card-visual-overlay"></div>
                    </div>
                    <div class="articulo-card-content">
                        <div class="articulo-card-top">
                            <span class="articulo-card-category">
                                @if (item.IdcategoriaNavigation != null)
                                {
                                    @item.IdcategoriaNavigation.Nombre
                                }
                                else
                                {
                                    <span>SIN CATEGORÍA</span>
                                }
                            </span>
                            <span class="articulo-card-date">
                                <i class="bi bi-calendar3"></i>
                                @fechaPublicacion
                            </span>
                        </div>
                        <h3 class="articulo-card-title">@item.Titulo</h3>
                        <p class="articulo-card-desc">@item.Resumen</p>
                        <div class="articulo-card-meta">
                            <span class="articulo-card-slug">
                                <i class="bi bi-link-45deg"></i>
                                @item.Slug
                            </span>
                            <span class="articulo-card-status @(item.Activo ? "active" : "inactive")">
                                @(item.Activo ? "● Activo" : "○ Inactivo")
                            </span>
                        </div>
                        <div class="articulo-card-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="articulo-card-btn">
                                Leer artículo <span class="arrow">→</span>
                            </a>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <div class="articulo-card-admin">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="admin-btn danger" title="Eliminar" onclick="return confirm('¿Estás seguro de que deseas eliminar este artículo?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="articulo-card-glow"></div>
                </article>
            }
        }
        else
        {
            <div class="articulos-empty">
                <span class="articulos-empty-icon">📄</span>
                <h3>Sin artículos publicados</h3>
                <p>No hay artículos disponibles en este momento.</p>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-action="Create" class="btn-primary">Crear primer artículo <span class="arrow">→</span></a>
                }
            </div>
        }
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // ========================= HERO TITLE ANIMATION =========================
        const heroTitle = document.getElementById("heroArticulosTitle");
        if (heroTitle) {
            setTimeout(() => {
                heroTitle.classList.add("is-in");
            }, 300);
        }

        // ========================= ARTICLES CARDS ANIMATION =========================
        const cards = document.querySelectorAll(".articulo-card");
        const cardObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add("is-visible");
                    }, index * 150);
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px"
        });

        cards.forEach(card => cardObserver.observe(card));
    });
</script>