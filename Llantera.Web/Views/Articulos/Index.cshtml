@model ICollection<Llantera.Application.DTOs.ArticulosDTO>

@{
    ViewData["Title"] = "Artículos — Llantera";
}

<h1>Artículos</h1>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Título</th>
                <th>Categoría</th>
                <th>Slug</th>
                <th>Resumen</th>
                <th>Publicado</th>
                <th>Activo</th>
                <th>Imagen</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var imageSrc = item.Imagen != null && item.Imagen.Length > 0
                        ? $"data:image/jpeg;base64,{Convert.ToBase64String(item.Imagen)}"
                        : null;

                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Titulo</td>
                        <td>@(item.IdcategoriaNavigation != null ? item.IdcategoriaNavigation.Nombre : "N/A")</td>
                        <td>@item.Slug</td>
                        <td>@item.Resumen</td>
                        <td>@(item.FechaPublicacion.HasValue ? item.FechaPublicacion.Value.ToString("yyyy-MM-dd") : "-")</td>
                        <td>@(item.Activo ? "Sí" : "No")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(imageSrc))
                            {
                                <img src="@imageSrc" alt="@item.Titulo" style="max-height:60px;" />
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8">No hay artículos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
