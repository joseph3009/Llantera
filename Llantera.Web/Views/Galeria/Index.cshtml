@model ICollection<Llantera.Application.DTOs.GaleriaDTO>

@{
    ViewData["Title"] = "Galería — Llantera";
}

<h1>Galería</h1>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Título</th>
                <th>Descripción</th>
                <th>Orden</th>
                <th>Activo</th>
                <th>Fecha</th>
                <th>Imagen</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model.OrderBy(x => x.Orden))
                {
                    var imageSrc = item.Imagen != null && item.Imagen.Length > 0
                        ? $"data:image/jpeg;base64,{Convert.ToBase64String(item.Imagen)}"
                        : null;

                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Titulo</td>
                        <td>@item.Descripcion</td>
                        <td>@item.Orden</td>
                        <td>@(item.Activo ? "Sí" : "No")</td>
                        <td>@item.FechaRegistro.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(imageSrc))
                            {
                                <img src="@imageSrc" alt="@item.Titulo" style="max-height:60px;" />
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">No hay imágenes en la galería.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
