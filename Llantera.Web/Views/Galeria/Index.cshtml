@model ICollection<Llantera.Application.DTOs.GaleriaDTO>

@{
    ViewData["Title"] = "Galería — Llantera Wifragara";
}

<!-- ================================ HERO GALERÍA ============================= -->
<section class="hero-galeria" id="hero-galeria">
    <div class="hero-galeria-media">
        <img class="hero-galeria-image"
             src="https://images.pexels.com/photos/3807695/pexels-photo-3807695.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1920"
             alt="Galería de imágenes automotrices" />
        <div class="hero-galeria-overlay"></div>
    </div>

    <div class="hero-galeria-content">
        <div class="hero-galeria-grid">
            <div class="hero-galeria-text">
                <p class="hero-galeria-eyebrow">LLANTERA WIFRAGARA</p>
                <h1 class="hero-galeria-title" id="heroGaleriaTitle">
                    <span class="line"><span class="line-inner">GALERÍA</span></span>
                    <span class="line"><span class="line-inner">VISUAL</span></span>
                    <span class="line"><span class="line-inner accent">WIFRAGARA</span></span>
                </h1>
                <p class="hero-galeria-sub">Imágenes que reflejan nuestro trabajo, pasión y compromiso con la excelencia</p>
            </div>
        </div>
    </div>

    <div class="scroll-cue"><span></span>DESPLÁZATE</div>
</section>

<!-- ================================ GALERÍA GRID ============================= -->
<section class="galeria-grid" id="galeria-lista">
    <div class="galeria-grid-head">
        <div class="galeria-grid-heading">
            <span class="galeria-grid-eyebrow">PORTFOLIO VISUAL</span>
            <h2>
                MOMENTOS<br>
                <span>QUE NOS DEFINEN</span>
            </h2>
        </div>
        <div class="galeria-grid-intro">
            <span class="galeria-grid-line"></span>
            <p>
                Cada imagen cuenta una historia de dedicación,
                calidad y atención al detalle en cada servicio
                que ofrecemos.
            </p>
        </div>
    </div>

    <div class="galeria-grid-container">
        @if (Model != null && Model.Any())
        {
            var index = 0;
            @foreach (var item in Model.OrderBy(x => x.Orden))
            {
                index++;
                var imageSrc = item.Imagen != null && item.Imagen.Length > 0
                    ? $"data:image/jpeg;base64,{Convert.ToBase64String(item.Imagen)}"
                    : "https://images.pexels.com/photos/3807695/pexels-photo-3807695.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800";

                <article class="galeria-item" data-index="@index">
                    <div class="galeria-item-visual">
                        <img src="@imageSrc"
                             alt="@item.Titulo"
                             loading="lazy" />
                        <div class="galeria-item-overlay">
                            <div class="galeria-item-content">
                                <span class="galeria-item-number">@index.ToString("D2")</span>
                                <h3 class="galeria-item-title">@item.Titulo</h3>
                                @if (!string.IsNullOrEmpty(item.Descripcion))
                                {
                                    <p class="galeria-item-desc">@item.Descripcion</p>
                                }
                                <div class="galeria-item-meta">
                                    <span class="galeria-item-date">
                                        <i class="bi bi-calendar3"></i>
                                        @item.FechaRegistro.ToString("dd MMM yyyy")
                                    </span>
                                    <span class="galeria-item-status @(item.Activo ? "active" : "inactive")">
                                        @(item.Activo ? "● Activo" : "○ Inactivo")
                                    </span>
                                </div>
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <div class="galeria-item-admin">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="admin-btn danger" title="Eliminar" onclick="return confirm('¿Estás seguro de que deseas eliminar esta imagen?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="galeria-empty">
                <span class="galeria-empty-icon">🖼️</span>
                <h3>Sin imágenes en la galería</h3>
                <p>No hay imágenes disponibles en este momento.</p>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-action="Create" class="btn-primary">Subir primera imagen <span class="arrow">→</span></a>
                }
            </div>
        }
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // ========================= HERO TITLE ANIMATION =========================
        const heroTitle = document.getElementById("heroGaleriaTitle");
        if (heroTitle) {
            setTimeout(() => {
                heroTitle.classList.add("is-in");
            }, 300);
        }

        // ========================= GALERIA ITEMS ANIMATION =========================
        const items = document.querySelectorAll(".galeria-item");
        const itemObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add("is-visible");
                    }, index * 100);
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px"
        });

        items.forEach(item => itemObserver.observe(item));
    });
</script>